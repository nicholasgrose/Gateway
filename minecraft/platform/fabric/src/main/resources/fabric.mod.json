{
  "schemaVersion": 1,
  "id": "gateway",
  "version": "${version}",
  "name": "Gateway",
  "description": "A plugin to integrate Discord and Minecraft.",
  "authors": [
    "Nicholas Rose"
  ],
  "contact": {
    "homepage": "https://github.com/nicholasgrose/Gateway",
    "sources": "https://github.com/nicholasgrose/Gateway"
  },
  "license": "MIT",
  "icon": "assets/gateway/icon.png",
  "environment": "server",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "xyz.rose.gateway.minecraft.platform.fabric.GatewayMod"
      }
    ]
  },
  "mixins": [
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.14.1+kotlin.2.4.20"
  },
  "suggests": {
  }
